.event-container {
  max-width: 600px;
  margin: 0 auto;
  padding: 20px 16px;
}

.event-header {
  text-align: left;
  margin-bottom: 24px;
}

.event-header h1 {
  font-size: 28px;
  font-weight: 600;
  margin: 0;
  color: var(--color-text);
}

.event-details {
  background: var(--color-surface);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.event-detail-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.event-detail-icon {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--color-muted);
}

.event-detail-value {
  font-size: 16px;
  color: var(--color-text);
  line-height: 1.5;
}

.event-actions {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  flex-direction: column;
}

.event-actions .btn {
  width: 100%;
  font-weight: 400;
  text-align: center;
}

@media (max-width: 500px) {
  .event-actions {
    flex-direction: column;
  }

  .event-actions .btn {
    width: 100%;
  }

  .event-header h1 {
    font-size: 24px;
  }
}

#cancel-remove, #yes-remove {
    width: 125px;
    height: 50px;
    font-size: x-large;
}

#cancel-remove {
    margin-right: 10%;
}

.modal, .modal-2 {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 9999; /* Sit on top */
  padding-top: 100px; /* Location of the box */
  left: 0;
  top: 0;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: auto; /* Enable scroll if needed */
  background-color: rgb(0,0,0); /* Fallback color */
  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
}

.modal__form { display: grid; gap: 12px; }

.field { display: grid; gap: 6px; }
.field > span { font-size: 13px; color: var(--color-muted); }
.field input, .field select {
  padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(0,0,0,.12);
  font: inherit; background: #fff;
}